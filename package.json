{
  "name": "@scene-ready/commons",
  "version": "0.2.0",
  "description": "Shared code for Scene Ready apps: cross-app references, the event standard, branded QR codes.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scene-Ready/commons.git"
  },
  "exports": {
    "./refs": {
      "types": "./dist/refs/index.d.ts",
      "default": "./dist/refs/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./qr": {
      "types": "./dist/qr/index.d.ts",
      "default": "./dist/qr/index.js"
    },
    "./qr/react": {
      "types": "./dist/qr/react.d.ts",
      "default": "./dist/qr/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "^16.5.0",
    "jsqr": "^1.4.0",
    "prettier": "3.10.0",
    "react": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.4"
  }
}
